<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net4.7.2</TargetFramework>
    <RootNamespace>SRMLInstaller</RootNamespace>
    <AssemblyName>SRMLInstaller</AssemblyName>
    <Authors>SlimeRancherModding</Authors>
    <Version>1.1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
      <_Parameter1>6f065c56-9575-45ca-846d-9660a0f80f79</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.4" />
    <PackageReference Include="Fody" Version="6.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Costura.Fody" Version="5.7.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Libs\0Harmony.dll" />
    <EmbeddedResource Include="Libs\INIFileParser.dll" />
    <EmbeddedResource Include="Libs\Newtonsoft.Json.dll" />
    <EmbeddedResource Include="Libs\SRML.dll" />
    <EmbeddedResource Include="Libs\SRML.Editor.dll" />
    <EmbeddedResource Include="Libs\System.Runtime.Serialization.dll" />
    <EmbeddedResource Include="Libs\SRML.xml" />
  </ItemGroup>

  <Target Name="CopyLibsForCostura" BeforeTargets="BeforeBuild">
    <MSBuild Projects="..\SRML\SRML.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
    <MSBuild Projects="..\SRML.Editor\SRML.Editor.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
    <MakeDir Directories="$(ProjectDir)Libs" />
    <ItemGroup>
      <FilesToEmbed Include="$(SolutionDir)SRML\bin\$(ConfigurationName)\net4.7.2\SRML.dll" />
      <FilesToEmbed Include="$(SolutionDir)SRML\bin\$(ConfigurationName)\net4.7.2\SRML.xml" />
      <FilesToEmbed Include="$(SolutionDir)SRML\bin\$(ConfigurationName)\net4.7.2\Newtonsoft.Json.dll" />
      <FilesToEmbed Include="$(SolutionDir)SRML\bin\$(ConfigurationName)\net4.7.2\0Harmony.dll" />
      <FilesToEmbed Include="$(SolutionDir)SRML\bin\$(ConfigurationName)\net4.7.2\SRML.Editor.dll" />
      <FilesToEmbed Include="$(SolutionDir)SRML\bin\$(ConfigurationName)\net4.7.2\INIFileParser.dll" />
      <FilesToEmbed Include="$(SolutionDir)Libs\System.Runtime.Serialization.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(FilesToEmbed)" DestinationFolder="$(ProjectDir)Libs" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="true" />
  </Target>
</Project>